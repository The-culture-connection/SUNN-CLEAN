rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The browser NEVER writes to Firestore and reads almost nothing. Every
    // mutation goes through a Next.js server route using the Admin SDK, which
    // bypasses these rules entirely. What follows is a safety net, not the
    // access path — the public site is server-rendered and reads through the
    // server too.

    match /reviews/{id} {
      allow read: if resource.data.status == 'approved';
      allow write: if false;
    }
    match /certifications/{id} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }
    match /galleryPairs/{id} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }
    match /catalogItems/{id} {
      allow read: if resource.data.active == true;
      allow write: if false;
    }

    // Everything else — bookings, invoices, crews, settings, crewDays,
    // notifications, contact messages, audit log — is server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
