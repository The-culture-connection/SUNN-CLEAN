# ---- Firebase Admin (server-side, secret) ----
FIREBASE_PROJECT_ID=sunn-cleaning
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@sunn-cleaning.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY_BASE64=
FIREBASE_STORAGE_BUCKET=sunn-cleaning.firebasestorage.app

# ---- Admin portal login ----
# Defaults to username "sunn clean" / password "sunnclean" if unset.
# CHANGE THESE IN PRODUCTION - the portal is on a public URL.
ADMIN_USERNAME=sunn clean
ADMIN_PASSWORD=sunnclean
# Optional signing key for the admin session cookie. If unset it is derived
# from the credentials above, so changing the password signs everyone out.
ADMIN_SESSION_SECRET=

# ---- App ----
BUSINESS_TIMEZONE=America/New_York
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
ADMIN_ALLOWED_EMAILS=grace-s@the-culture-connection.com
